# Nombres de las variables de entorno. Sin valores: cada uno se pone en .env.local,
# Vercel, Render o GitHub según docs/DESPLIEGUE.md §2.

# Base de datos (Neon en la nube; Postgres en Docker para pruebas)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# URLs
URL_PUBLICA=
URL_WORKER=

# Worker
SECRETO_WORKER=

# WhatsApp: simulador | meta
WHATSAPP_MODO=simulador
WHATSAPP_ID_NUMERO=
WHATSAPP_TOKEN=
WHATSAPP_SIMULAR_FALLO=

# Cloudflare R2
R2_ID_CUENTA=
R2_BUCKET=
R2_ID_CLAVE_ACCESO=
R2_CLAVE_ACCESO_SECRETA=

# Cifrado de la identidad del denunciante anónimo (32 bytes en base64)
CLAVE_CIFRADO=

# Mapa de incidentes
NEXT_PUBLIC_MAPA_URL_TESELAS=
