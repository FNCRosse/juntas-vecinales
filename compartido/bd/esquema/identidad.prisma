// Tablas del módulo identidad (M1, prefijo identidad_). Diagrama 02a.

enum EstadoUsuario {
  ACTIVA
  SUSPENDIDA
  DESVINCULADA
}

enum NombreRol {
  VECINO
  VECINO_ADULTO_MAYOR
  DIRECTIVA
  DIRECTIVO_MEDIADOR
  VIGILANTE
  ADMINISTRADOR
}

// Usuario (Persona del diagrama aplanada): un usuario puede tener varios roles (la directiva también es vecina).
model Usuario {
  id                   String               @id @default(uuid())
  nombreCompleto       String
  dni                  String               @unique(map: "identidad_usuarios_dni_unico")
  telefonoWhatsApp     String?
  estado               EstadoUsuario        @default(ACTIVA)
  roles                NombreRol[]
  fechaEmpadronamiento DateTime             @default(now())
  /// Aceptación expresa de la política de privacidad y su versión (HU-GAR-02 CA2, Ley 29733).
  politicaAceptadaEn   DateTime?
  politicaVersion      String?
  sesiones             Sesion[]
  credencial           CredencialRespaldo?
  residencias          Residencia[]
  enlaces              MagicLink[]
  perfilAccesibilidad  PerfilAccesibilidad?

  @@map("identidad_usuarios")
}

// Sesión persistente: la cookie lleva un token aleatorio de 32 bytes; aquí solo su hash SHA-256.
model Sesion {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  creadaEn    DateTime  @default(now())
  ultimoUsoEn DateTime  @default(now())
  revocadaEn  DateTime?

  @@index([usuarioId])
  @@map("identidad_sesiones")
}

// Clave: la de respaldo del vecino y la de las cuentas internas. scrypt con sal por usuario.
model CredencialRespaldo {
  usuarioId      String    @id
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  hash           String
  sal            String
  fallosSeguidos Int       @default(0)
  bloqueadaHasta DateTime?
  actualizadaEn  DateTime  @updatedAt

  @@map("identidad_credenciales")
}

enum EstadoGarita {
  VERDE
  ROJO
}

enum EstadoVisita {
  PROGRAMADA
  ANULADA
  LLEGO
  // Visita no anunciada (HU-GAR-07): espera la respuesta del vecino.
  ESPERANDO_RESPUESTA
  AUTORIZADA
  NO_AUTORIZADA
  NO_ENTRO
}

enum TipoVehiculo {
  AUTO_O_CAMIONETA
  MOTO
  TRICICLO_O_CARRETA
}

enum TipoRegistroAcceso {
  ENTRADA
  SALIDA
}

// Cómo entró (o no): para la bitácora y su valor de prueba (HU-GAR-08).
enum ModoAcceso {
  VECINO_REJA
  VECINO_A_MANO
  EMERGENCIA
  VISITA
  NO_ENTRO
}

enum UsoPredio {
  VIVIENDA
  NEGOCIO
  VIVIENDA_Y_NEGOCIO
}

// Qué es cada residente de la persona titular del predio (prototipo ADM-PAD-04).
enum RelacionResidencia {
  TITULAR
  CONYUGE
  HIJO
  PADRE
  OTRO
}

// Predio con su ocupación: la guarda M1; el monto de la cuota lo calcula M5 con ella.
model Predio {
  id           String       @id @default(uuid())
  manzana      String
  lote         String
  uso          UsoPredio
  familias     Int          @default(1)
  inquilinos   Int          @default(0)
  autos        Int          @default(0)
  motos        Int          @default(0)
  triciclos    Int          @default(0)
  negocios     Int          @default(0)
  creadoEn     DateTime     @default(now())
  /// Proyección del semáforo de la garita: VERDE por defecto; M5 la pasa a ROJO con
  /// actualizarEstadoMorosidad cuando la deuda llega a 8 semanas (modulos/identidad/CLAUDE.md).
  estadoGarita EstadoGarita @default(VERDE)
  residencias  Residencia[]
  visitas      Visita[]
  vehiculos    Vehiculo[]

  @@unique([manzana, lote], map: "identidad_predios_lote_unico")
  @@map("identidad_predios")
}

// Residencia (clase asociativa Usuario–Predio): desvincular cierra la residencia (fechaFin).
model Residencia {
  id          String             @id @default(uuid())
  usuarioId   String
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  predioId    String
  predio      Predio             @relation(fields: [predioId], references: [id])
  relacion    RelacionResidencia
  fechaInicio DateTime           @default(now())
  fechaFin    DateTime?

  @@index([predioId])
  @@index([usuarioId])
  @@map("identidad_residencias")
}

// Para qué sirve el enlace: entrar (HU-GAR-01, 02, 11), crear una clave nueva (HU-GAR-25) o crear
// el acceso de equipo con la invitación (HU-GAR-21).
enum PropositoEnlace {
  ENTRADA
  CLAVE
  EQUIPO
}

// Enlace de acceso de un solo uso (R-01): vence a los 15 min; se guarda solo el hash del token.
model MagicLink {
  id        String          @id @default(uuid())
  proposito PropositoEnlace @default(ENTRADA)
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  tokenHash String          @unique
  emitidoEn DateTime        @default(now())
  expiraEn  DateTime
  usadoEn   DateTime?
  anuladoEn DateTime?

  @@index([usuarioId])
  @@map("identidad_enlaces_acceso")
}

// Visita a una vivienda (HU-GAR-04): el vecino la anuncia y entra a la lista blanca de la garita
// durante 3 horas desde la hora indicada. Anularla la saca de la lista al instante (HU-GAR-05).
model Visita {
  id            String       @id @default(uuid())
  numero        Int          @unique @default(autoincrement())
  predioId      String
  predio        Predio       @relation(fields: [predioId], references: [id])
  registradaPor String
  nombre        String
  dni           String?
  desde         DateTime
  hasta         DateTime
  conVehiculo   Boolean      @default(false)
  placa         String?
  estado        EstadoVisita @default(PROGRAMADA)
  creadaEn      DateTime     @default(now())
  anuladaEn     DateTime?
  llegoEn       DateTime?
  /// No anunciada: la anotó el vigilante (HU-GAR-07 CA2).
  anunciada     Boolean      @default(true)
  motivo        String?
  respondidaEn  DateTime?
  /// "la app" o "por teléfono": por dónde respondió el vecino.
  respondidaPor String?

  @@index([predioId, estado])
  @@index([estado, desde])
  @@map("identidad_visitas")
}

// Vehículo de un predio (diagrama 02a): la garita lo consulta por la placa (HU-GAR-06).
model Vehiculo {
  id       String       @id @default(uuid())
  predioId String
  predio   Predio       @relation(fields: [predioId], references: [id])
  placa    String       @unique(map: "identidad_vehiculos_placa_unica")
  tipo     TipoVehiculo

  @@map("identidad_vehiculos")
}

// RegistroAcceso: la bitácora de la garita (HU-GAR-08). Solo inserción (trigger): la salida es una
// fila nueva que apunta a su entrada. Sin llaves foráneas a propósito: guarda la vivienda como se
// llamaba ese día y nunca se borra con el padrón.
model RegistroAcceso {
  id          String             @id @default(uuid())
  fecha       DateTime           @default(now())
  tipo        TipoRegistroAcceso
  modo        ModoAcceso
  quien       String
  placa       String?
  vivienda    String
  predioId    String?
  visitaId    String?
  entradaId   String?
  vigilanteId String
  detalle     String?

  @@unique([entradaId], map: "identidad_registros_acceso_una_salida")
  @@index([fecha])
  @@map("identidad_registros_acceso")
}
