// Tablas del módulo aportes (M5, prefijo aportes_).

enum UnidadCobro {
  POR_FAMILIA
  POR_VEHICULO
  POR_INQUILINO
  POR_LOCAL
}

enum TipoCambioTarifa {
  INICIAL
  AGREGAR
  CAMBIAR
}

// Una versión de la tarifa semanal (HU-COB-16). Cada cambio aprobado en asamblea crea una versión nueva con la
// lista completa de conceptos; nunca se edita ni se borra (trigger de solo inserción, docs/DATOS.md §3). La
// vigente es la última cuya vigencia ya llegó; las cuotas emitidas guardan una copia de lo que usaron, así que un
// cambio no las toca. El cambio que dio origen a la versión (qué concepto, de cuánto a cuánto) queda en la propia fila
// para el historial. idOperacion evita programar dos veces el mismo cambio al reintentar (AC-5).
model Tarifa {
  id            String           @id @default(uuid())
  idOperacion   String           @unique
  vigenciaDesde DateTime
  acta          String
  tipoCambio    TipoCambioTarifa
  cambioClave   String?
  cambioNombre  String?
  cambioUnidad  UnidadCobro?
  montoAnterior Int?
  montoNuevo    Int?
  autorId       String
  autor         String
  creadaEn      DateTime         @default(now())
  conceptos     ConceptoTarifa[]

  @@index([vigenciaDesde, creadaEn])
  @@map("aportes_tarifas")
}

// Un concepto de la tarifa en una versión (casa, auto o camioneta, moto, triciclo o carreta, inquilino, negocio y los
// que apruebe la asamblea). `clave` es estable entre versiones («auto»); el monto va en céntimos enteros por semana.
model ConceptoTarifa {
  id       String      @id @default(uuid())
  tarifaId String
  tarifa   Tarifa      @relation(fields: [tarifaId], references: [id])
  clave    String
  nombre   String
  unidad   UnidadCobro
  monto    Int
  orden    Int

  @@unique([tarifaId, clave])
  @@map("aportes_conceptos_tarifa")
}

enum EstadoCuota {
  PENDIENTE
  EN_DISCREPANCIA
  PAGADA
  VENCIDA
}

// Cuota semanal de una casa (HU-COB-01, diagrama 02b). El periodo es el lunes de la semana (0:00 de Lima, en UTC) y la
// fecha límite, el domingo siguiente a las 11:59 p. m. UNIQUE (predioId, periodo): la tarea del worker puede correr
// varias veces sin duplicar. Guarda la versión de la tarifa que usó y una copia de los conceptos y montos: un cambio
// de tarifa no la toca (HU-COB-16 CA3). El saldo baja con los pagos aprobados; el estado lo mueve el pago o la tarea.
model Cuota {
  id             String          @id @default(uuid())
  predioId       String
  periodo        DateTime
  fechaLimite    DateTime
  tarifaId       String
  montoCalculado Int
  saldoPendiente Int
  estado         EstadoCuota     @default(PENDIENTE)
  creadaEn       DateTime        @default(now())
  conceptos      CuotaConcepto[]

  @@unique([predioId, periodo])
  @@index([predioId, estado])
  @@map("aportes_cuotas")
}

// Copia de lo que se cobró en una cuota: concepto, monto por unidad y cuántas unidades había. Solo inserción.
model CuotaConcepto {
  id            String      @id @default(uuid())
  cuotaId       String
  cuota         Cuota       @relation(fields: [cuotaId], references: [id])
  clave         String
  nombre        String
  unidad        UnidadCobro
  montoUnitario Int
  cantidad      Int
  subtotal      Int
  orden         Int

  @@map("aportes_cuota_conceptos")
}

enum EstadoPago {
  REGISTRADO
  APROBADO
  OBSERVADO
  RECHAZADO
}

enum EstadoComprobante {
  PENDIENTE_REVISION
  APROBADO
  OBSERVADO
}

enum MotivoObservacion {
  MONTO_INSUFICIENTE
  IMAGEN_BORROSA
  FECHA_ERRONEA
  OTRO
}

// Cómo pagó una casa: digital (HU-COB-08) o efectivo que cobra la directiva en su casa (HU-COB-11).
enum MedioDePago {
  YAPE_O_PLIN
  TRANSFERENCIA
  EFECTIVO
}

// Pago que manda una casa (HU-COB-08): lo que declara pagar de sus cuotas y cómo. Nace REGISTRADO (en revisión) y la
// directiva lo aprueba, observa o rechaza (HU-COB-09 y 10). `numero` es el correlativo de la constancia de envío
// («E-0917»). idOperacion evita registrar dos veces al reintentar (AC-5). No cambia ninguna cuota hasta que se apruebe.
model Pago {
  id           String        @id @default(uuid())
  numero       Int           @unique @default(autoincrement())
  idOperacion  String        @unique
  predioId     String
  autorId      String
  medio        MedioDePago
  monto        Int
  estado       EstadoPago    @default(REGISTRADO)
  creadoEn     DateTime      @default(now())
  cuotas       PagoCuota[]
  comprobantes Comprobante[]
  recibo       Recibo?

  @@index([predioId, creadoEn])
  @@index([estado, creadoEn])
  @@map("aportes_pagos")
}

// Qué parte de cada cuota cubre un pago, fijada al enviarlo: así se sabe qué semanas están «en revisión» y qué se
// aplica al aprobarlo.
model PagoCuota {
  id      String @id @default(uuid())
  pagoId  String
  pago    Pago   @relation(fields: [pagoId], references: [id])
  cuotaId String
  monto   Int

  @@unique([pagoId, cuotaId])
  @@index([cuotaId])
  @@map("aportes_pago_cuotas")
}

// La captura o el PDF del pago (archivo en R2 con `compartido/archivos`). Un pago puede tener varios: si la directiva
// lo observa, la casa manda otra foto.
model Comprobante {
  id                String             @id @default(uuid())
  pagoId            String
  pago              Pago               @relation(fields: [pagoId], references: [id])
  archivoId         String
  estado            EstadoComprobante  @default(PENDIENTE_REVISION)
  motivoObservacion MotivoObservacion?
  nota              String?
  creadoEn          DateTime           @default(now())

  @@index([pagoId])
  @@map("aportes_comprobantes")
}

// Recibo digital oficial de un pago aprobado (HU-COB-12). Se emite al aprobar el pago, con su correlativo («000321»), y
// guarda lo que dice el papel: titular, vivienda, concepto, medio y quién lo registró. No se puede modificar ni borrar
// (trigger): solo se anota cuándo se envió a la app y cuándo la casa confirmó que lo recibió. El código de verificación
// no se guarda: se calcula con el número, el pago y el monto (dominio/recibo.ts). Un recibo por pago.
model Recibo {
  id              String              @id @default(uuid())
  numero          Int                 @unique @default(autoincrement())
  pagoId          String              @unique
  pago            Pago                @relation(fields: [pagoId], references: [id])
  predioId        String
  titular         String
  vivienda        String
  concepto        String
  medio           String
  monto           Int
  fecha           DateTime
  registradoPor   String
  registradoPorId String
  enviadoEn       DateTime?
  confirmadoEn    DateTime?
  pedidos         PedidoReciboPapel[]

  @@index([predioId, fecha])
  @@map("aportes_recibos")
}

enum FranjaDeVisita {
  MANANA
  TARDE
  NOCHE
}

enum EstadoPedidoRecibo {
  POR_ENTREGAR
  ENTREGADO
}

// La casa pide su recibo en papel (VEC-COB-14): la directiva se lo lleva en la franja que eligió y lo marca entregado.
// idOperacion evita pedirlo dos veces al reintentar (AC-5); un recibo no tiene dos pedidos por entregar a la vez.
model PedidoReciboPapel {
  id             String             @id @default(uuid())
  numero         Int                @unique @default(autoincrement())
  idOperacion    String             @unique
  reciboId       String
  recibo         Recibo             @relation(fields: [reciboId], references: [id])
  solicitanteId  String
  franja         FranjaDeVisita?
  nota           String?
  estado         EstadoPedidoRecibo @default(POR_ENTREGAR)
  creadoEn       DateTime           @default(now())
  entregadoEn    DateTime?
  entregadoPorId String?

  @@index([estado, creadoEn])
  @@index([reciboId, estado])
  @@map("aportes_pedidos_recibo_papel")
}

enum EstadoPedidoCobro {
  PENDIENTE
  COBRADO
  CANCELADO
}

// La casa pide que la directiva vaya a cobrarle en efectivo (VEC-COB-02 y 13). No cobra nada ni reserva semanas: guarda
// cuánto pensaba pagar y a qué hora le queda mejor. La directiva lo cobra (DIR-COB-08) y queda enlazado al pago.
// idOperacion evita pedirlo dos veces al reintentar (AC-5); una casa tiene a lo más un pedido pendiente.
model PedidoCobroEnCasa {
  id            String            @id @default(uuid())
  numero        Int               @unique @default(autoincrement())
  idOperacion   String            @unique
  predioId      String
  solicitanteId String
  semanas       Int
  monto         Int
  franja        FranjaDeVisita
  nota          String?
  estado        EstadoPedidoCobro @default(PENDIENTE)
  creadoEn      DateTime          @default(now())
  pagoId        String?           @unique
  cobradoEn     DateTime?

  @@index([estado, creadoEn])
  @@index([predioId, estado])
  @@map("aportes_pedidos_cobro_en_casa")
}

// Bitácora de los recordatorios amables (HU-COB-05): uno por cuota, cuando la casa cumple 7 días de retraso. UNIQUE por
// cuota hace idempotente la tarea del worker: correrla varias veces, o dos a la vez, no avisa dos veces. Solo inserción
// (trigger). No aplica sanciones en garita ni recargos: solo deja constancia de qué se avisó y cuándo.
model AlertaPreventiva {
  id                 String   @id @default(uuid())
  cuotaId            String   @unique
  predioId           String
  diasDeRetraso      Int
  debe               Int
  residentesAvisados Int
  enviadaEn          DateTime @default(now())

  @@index([predioId, enviadaEn])
  @@map("aportes_alertas_preventivas")
}

enum MotivoReclamo {
  SIN_INQUILINO
  MENOS_VEHICULOS
  YA_PAGUE
  OTRO
}

enum EstadoReclamo {
  EN_REVISION
  APROBADO
  RECHAZADO
}

// Reclamo de la casa por el monto de su cuota (HU-COB-03; el nombre del diagrama 02b es SolicitudAjusteTarifa). Cubre las
// cuotas que la casa todavía debe: mientras la directiva no responde, pasan a EN_DISCREPANCIA y guardan su estado anterior
// (ReclamoCuota) para devolverlo si se mantiene el importe (HU-COB-04). Una casa tiene a lo más un reclamo en revisión
// (índice único parcial). idOperacion evita enviarlo dos veces al reintentar (AC-5). El sustento es un archivo opcional.
model SolicitudAjusteTarifa {
  id               String         @id @default(uuid())
  numero           Int            @unique @default(autoincrement())
  idOperacion      String         @unique
  predioId         String
  solicitanteId    String
  motivo           MotivoReclamo
  detalle          String?
  archivoId        String?
  estado           EstadoReclamo  @default(EN_REVISION)
  creadoEn         DateTime       @default(now())
  // La respuesta de la directiva (HU-COB-04): quién y cuándo decidió, qué concepto se ajustó si se aprobó y el motivo que
  // se le explica a la casa si el importe se mantiene.
  decididoPorId    String?
  decididoEn       DateTime?
  conceptoAjustado String?
  respuesta        String?
  cuotas           ReclamoCuota[]

  @@index([predioId, estado])
  @@index([estado, creadoEn])
  @@map("aportes_ajustes")
}

// Una cuota cubierta por un reclamo y el estado en que estaba, para devolverlo si el importe se mantiene.
model ReclamoCuota {
  id             String                @id @default(uuid())
  reclamoId      String
  reclamo        SolicitudAjusteTarifa @relation(fields: [reclamoId], references: [id])
  cuotaId        String
  estadoAnterior EstadoCuota
  // Lo que valía la cuota y lo que vale si se aprobó el ajuste (HU-COB-04).
  montoAnterior  Int?
  montoNuevo     Int?

  @@unique([reclamoId, cuotaId])
  @@index([cuotaId])
  @@map("aportes_ajuste_cuotas")
}
