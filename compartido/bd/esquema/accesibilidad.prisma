// Tablas del módulo accesibilidad (M6, prefijo accesibilidad_).

enum EscalaTipografica {
  NORMAL
  GRANDE
  MUY_GRANDE
}

// PerfilAccesibilidad (ADR-004). Sin sesión, se identifica por la cookie "perfil" del dispositivo;
// al entrar, pasa a la cuenta (usuarioId) y se lee por la sesión desde cualquier dispositivo (R-10).
model PerfilAccesibilidad {
  id                           String            @id @default(uuid())
  usuarioId                    String?           @unique
  usuario                      Usuario?          @relation(fields: [usuarioId], references: [id])
  modoSeniorActivo             Boolean           @default(false)
  escalaTipografica            EscalaTipografica @default(NORMAL)
  altoContrasteActivo          Boolean           @default(false)
  sintesisVozActiva            Boolean           @default(false)
  confirmacionEnDosPasosActiva Boolean           @default(true)
  areaTactilAmpliada           Boolean           @default(false)
  creadoEn                     DateTime          @default(now())
  actualizadoEn                DateTime          @updatedAt

  @@map("accesibilidad_perfiles")
}

enum ModoApoyo {
  LLAMADA
  WHATSAPP
  VISITA
}

enum EstadoApoyo {
  PENDIENTE
  EN_ATENCION
  ATENDIDA
}

// Solicitud al CanalMediacionHumana (HU-ACC-04): quién pide, en qué pantalla se quedó y cómo
// prefiere que le ayuden. El nombre y la vivienda se guardan como se veían al pedir (accesibilidad no
// lee identidad, ARQUITECTURA §3).
model SolicitudApoyo {
  id          String      @id @default(uuid())
  numero      Int         @unique @default(autoincrement())
  usuarioId   String
  quien       String
  pantalla    String
  modo        ModoApoyo
  detalle     String?
  estado      EstadoApoyo @default(PENDIENTE)
  atendidaPor String?
  creadaEn    DateTime    @default(now())
  cambiadaEn  DateTime    @updatedAt

  @@index([usuarioId])
  @@index([estado, creadaEn])
  @@map("accesibilidad_solicitudes_apoyo")
}

// Secciones con guía propia (HU-ACC-10). M3 deja Incidentes; M4 y M5 agregan Asambleas y Mi cuota.
enum SeccionGuia {
  INCIDENTES
}

enum EstadoGuia {
  EN_CURSO
  PAUSADA
  OMITIDA
  COMPLETADA
}

// OnboardingGuiado (HU-ACC-10): hasta dónde llegó cada persona en la guía de cada sección. Sin fila, la
// guía se ofrece; completada u omitida, ya no se ofrece sola (R-10), pero se puede volver a ver.
model GuiaSeccion {
  usuarioId     String
  seccion       SeccionGuia
  estado        EstadoGuia
  paso          Int         @default(0)
  actualizadaEn DateTime    @updatedAt

  @@id([usuarioId, seccion])
  @@map("accesibilidad_guias")
}
