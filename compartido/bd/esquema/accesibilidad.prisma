// Tablas del módulo accesibilidad (M6, prefijo accesibilidad_).

enum EscalaTipografica {
  NORMAL
  GRANDE
  MUY_GRANDE
}

// PerfilAccesibilidad (ADR-004). Sin sesión, se identifica por la cookie "perfil" del dispositivo;
// al entrar, pasa a la cuenta (usuarioId) y se lee por la sesión desde cualquier dispositivo (R-10).
model PerfilAccesibilidad {
  id                           String            @id @default(uuid())
  usuarioId                    String?           @unique
  usuario                      Usuario?          @relation(fields: [usuarioId], references: [id])
  modoSeniorActivo             Boolean           @default(false)
  escalaTipografica            EscalaTipografica @default(NORMAL)
  altoContrasteActivo          Boolean           @default(false)
  sintesisVozActiva            Boolean           @default(false)
  confirmacionEnDosPasosActiva Boolean           @default(true)
  areaTactilAmpliada           Boolean           @default(false)
  creadoEn                     DateTime          @default(now())
  actualizadoEn                DateTime          @updatedAt

  @@map("accesibilidad_perfiles")
}
