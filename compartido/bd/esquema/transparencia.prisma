// Tablas del módulo transparencia (M2), prefijo transparencia_.

enum TipoPublicacion {
  COMUNICADO
  ACTA
  BALANCE
}

enum NivelUrgencia {
  INFORMATIVO
  URGENTE
}

// Todo lo que la junta publica a la comunidad. Es inalterable: un trigger rechaza UPDATE y DELETE
// (docs/DATOS.md §3); corregir es publicar otra y enlazarla con corrigeAId. idOperacion lo genera el
// dispositivo y evita publicar dos veces al reintentar (AC-5). El autor se guarda como figuraba al publicar.
model Publicacion {
  id               String             @id @default(uuid())
  tipo             TipoPublicacion
  titulo           String
  fechaPublicacion DateTime           @default(now())
  autorId          String
  autor            String
  corrigeAId       String?
  corrigeA         Publicacion?       @relation("Correccion", fields: [corrigeAId], references: [id])
  correcciones     Publicacion[]      @relation("Correccion")
  idOperacion      String             @unique
  comunicado       ComunicadoGeneral?
  acta             ActaDigital?
  balance          BalanceFinanciero?

  @@index([fechaPublicacion])
  @@map("transparencia_publicaciones")
}

model ComunicadoGeneral {
  publicacionId String        @id
  publicacion   Publicacion   @relation(fields: [publicacionId], references: [id])
  cuerpo        String
  urgencia      NivelUrgencia

  @@map("transparencia_comunicados")
}

// Acta de una asamblea (HU-ASA-11). Si es de una asamblea de la plataforma se enlaza con ella (M4); si es anterior,
// se registra con título y fecha. La aprobación de la directiva es la confirmación al publicar: no se guardan borradores.
model ActaDigital {
  publicacionId  String      @id
  publicacion    Publicacion @relation(fields: [publicacionId], references: [id])
  fechaAsamblea  DateTime
  // La asamblea de M4 de la que es el acta (id de la convocatoria). Vacío en las actas de antes de la plataforma.
  convocatoriaId String?
  acuerdos       String[]
  compromisos    String[]
  conclusiones   String

  @@map("transparencia_actas")
}

// Balance de una actividad pro fondos (HU-ASA-10). Si es de una actividad de la plataforma se enlaza con ella (M4);
// si es anterior, se identifica por su nombre (el título de la publicación) y su fecha. Los montos son céntimos enteros; la utilidad neta
// se calcula, no se guarda.
model BalanceFinanciero {
  publicacionId     String      @id
  publicacion       Publicacion @relation(fields: [publicacionId], references: [id])
  fechaActividad    DateTime
  // La actividad pro fondos de M4 de la que es el balance (id de la convocatoria). Vacío si fue anterior a la plataforma.
  convocatoriaId    String?
  ingresosVirtuales Int
  ingresosEnPuerta  Int
  egresos           Egreso[]

  @@map("transparencia_balances")
}

model Egreso {
  id        String            @id @default(uuid())
  balanceId String
  balance   BalanceFinanciero @relation(fields: [balanceId], references: [publicacionId])
  orden     Int
  concepto  String
  monto     Int
  archivoId String
  archivo   Archivo           @relation(fields: [archivoId], references: [id])

  @@index([balanceId])
  @@map("transparencia_egresos")
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

// Lo que entra y sale de la caja de vigilancia además de las cuotas, que se suman solas con los recibos (HU-COB-14, DIR-TRA-03 y
// 04). Solo inserción (trigger): un error se corrige con otro movimiento, no se borra. Un gasto lleva la foto de su comprobante.
// idOperacion evita registrarlo dos veces al reintentar (AC-5). Montos en céntimos enteros.
model MovimientoDeCaja {
  id          String         @id @default(uuid())
  idOperacion String         @unique
  tipo        TipoMovimiento
  // La clave del concepto de la lista (dominio/caja.ts): «VIGILANTES», «DONACION»…
  concepto    String
  detalle     String?
  monto       Int
  fecha       DateTime
  archivoId   String?
  autorId     String
  autor       String
  creadoEn    DateTime       @default(now())

  @@index([fecha])
  @@map("transparencia_movimientos_caja")
}

// La rendición de cuentas de un mes que la directiva publica a los vecinos (DIR-TRA-02): una por mes y para siempre (trigger). Guarda
// los totales y los gastos por concepto como estaban al publicar; los vecinos ven solo esto (VEC-TRA-01), nunca los comprobantes.
model RendicionPublicada {
  id                String   @id @default(uuid())
  idOperacion       String   @unique
  // «2026-09».
  mes               String   @unique
  ingresosPorCuotas Int
  ingresosOtros     Int
  gastos            Int
  comprobantes      Int
  // [{ concepto: "Pago a vigilantes", monto: 140000 }], del mayor al menor.
  gastosPorConcepto Json
  publicadaPorId    String
  publicadaPor      String
  publicadaEn       DateTime @default(now())

  @@map("transparencia_rendiciones")
}
