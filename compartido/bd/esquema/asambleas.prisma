// Tablas del módulo asambleas (M4), prefijo asambleas_. Diagrama 02c.

enum TipoConvocatoria {
  ASAMBLEA
  EVENTO_PRO_FONDOS
}

enum EstadoConvocatoria {
  BORRADOR
  PUBLICADA
  REPROGRAMADA
  INFORMATIVA
  CERRADA
}

enum TipoAsamblea {
  ORDINARIA
  EXTRAORDINARIA
}

enum CondicionApoderado {
  FAMILIAR
  VECINO
  EXTERNO
}

enum ModoConfirmacion {
  DIGITAL
  ASISTIDA
}

// Convocatoria de la junta (diagrama 02c, abstracta). La versión imprimible (afiche A4) se arma de esta
// misma fila: fecha, hora, lugar y motivo nunca se escriben dos veces (HU-ASA-01 CA3). idOperacion lo
// genera el dispositivo y evita publicar dos veces al reintentar (AC-5). El autor se guarda tal como
// figuraba al publicar.
model Convocatoria {
  id               String             @id @default(uuid())
  tipo             TipoConvocatoria
  titulo           String
  fechaHora        DateTime
  lugar            String
  motivo           String
  estado           EstadoConvocatoria @default(PUBLICADA)
  autorId          String
  autor            String
  fechaPublicacion DateTime           @default(now())
  idOperacion      String             @unique
  asamblea         Asamblea?
  confirmaciones   ConfirmacionAsistencia[]
  delegaciones     DelegacionVoto[]
  checkIns         CheckInPresencial[]

  @@index([fechaHora])
  @@map("asambleas_convocatorias")
}

// Confirmación de asistencia a una asamblea (HU-ASA-02, HU-ASA-03). Una por predio (un voto por predio),
// editable hasta el plazo. `modo` distingue la confirmación propia del vecino (DIGITAL) de la registrada
// por un mediador (ASISTIDA, con el usuarioId en `registradaPor`), para medir la participación autónoma.
model ConfirmacionAsistencia {
  id             String           @id @default(uuid())
  convocatoriaId String
  convocatoria   Convocatoria     @relation(fields: [convocatoriaId], references: [id])
  predioId       String
  modo           ModoConfirmacion
  registradaPor  String?
  creadaEn       DateTime         @default(now())

  @@unique([convocatoriaId, predioId])
  @@index([convocatoriaId])
  @@map("asambleas_confirmaciones")
}

// Datos propios de una asamblea (HU-ASA-01). El quórum requerido y el total del padrón se fijan al
// publicar (un voto por predio); el conteo real de confirmaciones llega en HU-ASA-02/04. Una sesión
// informativa (sin quórum, HU-ASA-05) no tendrá votaciones ni acuerdos resolutivos.
model Asamblea {
  convocatoriaId     String       @id
  convocatoria       Convocatoria @relation(fields: [convocatoriaId], references: [id])
  tipoAsamblea       TipoAsamblea
  padronTotal        Int
  quorumRequerido    Int
  confirmacionesHasta DateTime
  // Cuándo el worker avisó a la directiva si el quórum proyectado alcanza al corte (HU-ASA-04 CA3). Se
  // reclama con un UPDATE condicionado a que siga vacío, así el aviso sale una sola vez aunque corran dos.
  avisoCorteEn       DateTime?
  // Cuándo la directiva abrió las votaciones tras comprobar el quórum definitivo (HU-ASA-07 CA3). Sin esta
  // marca no se registran votaciones ni acuerdos.
  votacionesAbiertasEn DateTime?

  @@map("asambleas_asambleas")
}

// Delegación del voto de un predio en un apoderado para una asamblea (HU-ASA-06). Una por predio y asamblea;
// anularla la borra (queda en la auditoría). Del apoderado se guarda el nombre y el DNI solo como hash,
// más sus dos últimas cifras para mostrarlo («DNI terminado en 32»): el hash permite contar cuántas casas
// representa y validarlo en la mesa sin guardar el número (minimización, docs/DATOS.md). `numero` es el
// correlativo de la constancia («D-0031»).
model DelegacionVoto {
  id                String             @id @default(uuid())
  numero            Int                @unique @default(autoincrement())
  convocatoriaId    String
  convocatoria      Convocatoria       @relation(fields: [convocatoriaId], references: [id])
  predioId          String
  titularId         String
  apoderadoNombre   String
  apoderadoDniHash  String
  apoderadoDniFinal String
  condicion         CondicionApoderado
  creadaEn          DateTime           @default(now())
  // El poder se valida en la puerta el día de la asamblea (HU-ASA-07): solo entonces cuenta para el quórum.
  validadaEn        DateTime?
  validadaPor       String?

  @@unique([convocatoriaId, predioId])
  @@index([convocatoriaId, apoderadoDniHash])
  @@map("asambleas_delegaciones")
}

// Pase de lista del día de la asamblea (HU-ASA-07): la casa cuyo titular llegó. Una por predio y asamblea; el
// quórum definitivo cuenta solo a los presentes y a los poderes validados aquí.
model CheckInPresencial {
  id             String       @id @default(uuid())
  convocatoriaId String
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id])
  predioId       String
  acreditadoPor  String
  creadoEn       DateTime     @default(now())

  @@unique([convocatoriaId, predioId])
  @@map("asambleas_checkins")
}
