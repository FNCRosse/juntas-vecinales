// Tablas del núcleo compartido (prefijo nucleo_).

enum ResultadoEjecucion {
  EXITOSA
  FALLIDA
}

// Una fila por cada llamada a POST /tareas/ejecutar que obtuvo el cerrojo.
model EjecucionWorker {
  id          String             @id @default(uuid())
  iniciadaEn  DateTime           @default(now())
  terminadaEn DateTime?
  resultado   ResultadoEjecucion
  detalle     String?

  @@map("nucleo_ejecuciones_worker")
}

// Registro consolidado de acciones críticas (AC-6). Solo inserción: un trigger rechaza UPDATE y DELETE.
// actorId es el id del usuario (null cuando actúa el sistema); la llave foránea llega con Usuario en M1.
model RegistroAuditoria {
  id        String   @id @default(uuid())
  fecha     DateTime @default(now())
  actorId   String?
  accion    String
  entidad   String
  entidadId String
  antes     Json?
  despues   Json?

  @@index([entidad, entidadId])
  @@index([fecha])
  @@map("nucleo_auditoria")
}
