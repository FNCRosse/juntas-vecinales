// Tablas del núcleo compartido (prefijo nucleo_).

enum ResultadoEjecucion {
  EXITOSA
  FALLIDA
}

// Una fila por cada llamada a POST /tareas/ejecutar que obtuvo el cerrojo.
model EjecucionWorker {
  id          String             @id @default(uuid())
  iniciadaEn  DateTime           @default(now())
  terminadaEn DateTime?
  resultado   ResultadoEjecucion
  detalle     String?

  @@map("nucleo_ejecuciones_worker")
}

// Registro consolidado de acciones críticas (AC-6). Solo inserción: un trigger rechaza UPDATE y DELETE.
// actorId es el id del usuario (null cuando actúa el sistema); la llave foránea llega con Usuario en M1.
model RegistroAuditoria {
  id        String   @id @default(uuid())
  fecha     DateTime @default(now())
  actorId   String?
  accion    String
  entidad   String
  entidadId String
  antes     Json?
  despues   Json?

  @@index([entidad, entidadId])
  @@index([fecha])
  @@map("nucleo_auditoria")
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADA
  FALLIDA
  SIN_CANAL_EXTERNO
}

// Cola de avisos (ADR-006). El emisor solo encola; el worker escribe primero la copia interna
// y luego intenta WhatsApp con reintentos de espera creciente (1, 4 y 16 min).
// De qué trata el aviso: el centro de notificaciones filtra por tipo y las preferencias deciden
// qué tipos salen por WhatsApp (HU-GAR-18, HU-GAR-20). CUENTA y SEGURIDAD salen siempre.
enum TipoAviso {
  CUENTA
  SEGURIDAD
  PAGOS
  ASAMBLEAS
  REPORTES
  GARITA
  NOTICIAS
}

model AvisoEnCola {
  id              String        @id @default(uuid())
  creadoEn        DateTime      @default(now())
  destinatarioId  String
  tipo            TipoAviso     @default(CUENTA)
  titulo          String
  texto           String
  // Canal externo: sin teléfono el aviso queda solo en el centro de notificaciones.
  telefono        String?
  plantilla       String?
  parametros      String[]
  estado          EstadoEnvio   @default(PENDIENTE)
  intentos        Int           @default(0)
  reintentarDesde DateTime      @default(now())
  canal           String?
  enviadoEn       DateTime?
  ultimoError     String?
  notificacion    Notificacion?

  @@index([estado, reintentarDesde])
  @@map("nucleo_cola_avisos")
}

// Copia interna: lo que ve el vecino en su centro de notificaciones (HU-GAR-20, M1).
model Notificacion {
  id             String      @id @default(uuid())
  creadaEn       DateTime    @default(now())
  destinatarioId String
  tipo           TipoAviso   @default(CUENTA)
  titulo         String
  texto          String
  leidaEn        DateTime?
  avisoId        String      @unique
  aviso          AvisoEnCola @relation(fields: [avisoId], references: [id])

  @@index([destinatarioId, creadaEn])
  @@map("nucleo_notificaciones")
}

// Qué avisos quiere recibir por WhatsApp cada persona (HU-GAR-18). Sin fila, los valores por defecto.
model PreferenciaAviso {
  usuarioId     String   @id
  whatsapp      Boolean  @default(true)
  pagos         Boolean  @default(true)
  asambleas     Boolean  @default(true)
  reportes      Boolean  @default(true)
  garita        Boolean  @default(true)
  noticias      Boolean  @default(false)
  actualizadaEn DateTime @updatedAt

  @@map("nucleo_preferencias_aviso")
}
